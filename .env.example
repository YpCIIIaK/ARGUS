DISCORD_TOKEN=
OPENROUTER_API_KEY=
# Optional Claude Code subscription provider. Generate locally with `claude setup-token`.
CLAUDE_CODE_OAUTH_TOKEN=
CLAUDE_CODE_TIMEOUT_MS=300000
# Self-hosted SearXNG used by the Researcher. The Blueprint fills these automatically.
SEARXNG_URL=
SEARXNG_TOKEN=
# Optional fallback if self-hosted search is not configured.
JINA_API_KEY=
# Optional CodeSandbox SDK token used for isolated code execution.
CSB_API_KEY=
ROUTER_ENABLED=true
# Tried from left to right when a rules-only decision is not confident enough.
ROUTER_MODELS=nex-agi/nex-n2.5-mini:free,inclusionai/ling-3.0-flash-sante:free,qwen/qwen3.8-27b:free,nvidia/nemotron-3.5-lightning:free,poolside/laguna-s-2.1:free
# Supabase: use the Session pooler URI on port 5432 for this long-running service.
DATABASE_URL=
PORT=10000
TIME_ZONE=Asia/Qyzylorda

# Comma-separated channel IDs. Empty means every text channel visible to the bot.
ALLOWED_CHANNEL_IDS=

# Discord user IDs allowed to pause/resume the agents. Empty means server administrators.
OWNER_IDS=

# Discord channel used only by the external Bounty Monitor webhook.
BOUNTY_CHANNEL_ID=
BOUNTY_MONITOR_URL=https://your-project.vercel.app
# Must match MANUAL_TOKEN in the Bounty Monitor Vercel project.
BOUNTY_MONITOR_TOKEN=

# Optional: channel names are auto-detected; IDs make the mapping unambiguous.
PROGRAMMER_CHANNEL_ID=
ENGINEER_CHANNEL_ID=
CREATIVE_CHANNEL_ID=
RESEARCHER_CHANNEL_ID=
COORDINATOR_CHANNEL_ID=

# Any OpenRouter model identifier can be used here.
DEFAULT_MODEL=openrouter/auto
PROGRAMMER_MODEL=
ENGINEER_MODEL=
CREATIVE_MODEL=
RESEARCHER_MODEL=
COORDINATOR_MODEL=
PROGRAMMER_EFFORT=low
ENGINEER_EFFORT=low
CREATIVE_EFFORT=low
RESEARCHER_EFFORT=low
COORDINATOR_EFFORT=low

MAX_AGENT_REPLIES=5
MAX_CONTEXT_MESSAGES=20
DAILY_REQUEST_LIMIT=100
AUTONOMOUS_ENABLED=false
AUTONOMOUS_INTERVAL_MINUTES=30

# Optional GitHub App OAuth integration. Use a 32-byte random key encoded as base64.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_SLUG=
GITHUB_CALLBACK_URL=https://your-render-service.onrender.com/auth/github/callback
GITHUB_TOKEN_ENCRYPTION_KEY=
