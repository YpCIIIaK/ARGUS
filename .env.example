DISCORD_TOKEN=
OPENROUTER_API_KEY=
DATABASE_URL=
PORT=10000

# Comma-separated channel IDs. Empty means every text channel visible to the bot.
ALLOWED_CHANNEL_IDS=

# Discord user IDs allowed to pause/resume the agents. Empty means server administrators.
OWNER_IDS=

# Any OpenRouter model identifier can be used here.
DEFAULT_MODEL=openrouter/auto
PROGRAMMER_MODEL=
ENGINEER_MODEL=
CREATIVE_MODEL=
RESEARCHER_MODEL=
COORDINATOR_MODEL=

MAX_AGENT_REPLIES=4
MAX_CONTEXT_MESSAGES=20
DAILY_REQUEST_LIMIT=100
AUTONOMOUS_ENABLED=false
AUTONOMOUS_INTERVAL_MINUTES=30
